            },
            {
              "name": "dossierProjet"
            }
          ]
        }
      }
    },
    {
      "id": "1b9dbb51-a86a-4081-9ce7-45265df3bc9c",
      "name": "Jira : état du ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "options": {},
        "method": "GET",
        "url": "={{ $('Demande de déplacement').first().json.jiraSite }}/rest/api/3/issue/{{ $('Demande de déplacement').first().json.cleStory }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "status"
            },
            {
              "name": "expand",
              "value": "transitions"
            }
          ]
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "ab198fb7-ff93-4f11-8c69-cf12f450699c",
      "name": "Choisir la colonne",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ],
      "parameters": {
        "jsCode": "// La colonne demandee = un statut du tableau Jira. Comparaison sans accents ni majuscules.\nconst demande = $('Demande de déplacement').first().json;\nconst ticket = $input.first().json;\nconst norm = (s) => String(s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\nconst voulu = norm(demande.colonne);\nif (norm(ticket.fields?.status?.name) === voulu) return [{ json: { action: 'deja' } }];\nconst transitions = ticket.transitions || [];\nconst t = transitions.find((x) => norm(x.to?.name) === voulu) || transitions.find((x) => norm(x.name) === voulu);\nif (t) return [{ json: { action: 'deplacer', id: t.id } }];\nreturn [{ json: { action: 'introuvable', possibles: transitions.map((x) => x.to?.name).filter(Boolean).join(', ') || 'aucune' } }];"
      }
    },
    {
      "id": "d71f75c4-410b-4165-8252-6d2bb84cedae",
      "name": "À déplacer ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        840,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a044b9d2-3c8c-499d-91c9-90a392d001e4",
              "leftValue": "={{ $json.action }}",
              "rightValue": "deplacer",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
