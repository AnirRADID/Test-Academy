        "url": "={{ $json.jiraSite }}/rest/api/3/issue/{{ $json.cle }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"update\":{\"labels\":[{\"remove\":\"qa-en-cours\"},{\"remove\":\"qa-a-valider\"},{\"remove\":\"qa-termine\"},{\"remove\":\"qa-bloque\"}]}}",
