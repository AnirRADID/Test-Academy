        440,
        100
      ],
      "parameters": {
        "jsCode": "// La liste envoyee par la Tour : { \"stories\": [{ \"cle\": \"HVC-6\", \"titre\": \"...\" }, ...] }\nconst corps = $('Remise à zéro demandée par la Tour').first().json.body || {};\nconst r = $('Réglages').first().json;\nreturn (corps.stories || [])\n  .filter(s => /^[A-Z][A-Z0-9]+-\\d+$/.test(String(s.cle || '')))\n  .map(s => ({ json: { cle: s.cle, titre: String(s.titre || '').slice(0, 150), jiraSite: r.jiraSite, dossierProjet: r.dossierProjet } }));"
      }
    },
    {
      "id": "f63e1331-1e1c-416c-a626-b54fa8bc4499",
      "name": "Jira : retirer les étiquettes qa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
