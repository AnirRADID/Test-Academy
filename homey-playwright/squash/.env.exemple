# Copie ce fichier sous le nom .env (sans rien d'autre), dans le meme dossier.
# Les trois valeurs sont des secrets : n'importe quelles chaines au hasard font l'affaire,
# mais elles ne doivent PAS changer une fois Squash demarre.
#
# Pour les fabriquer, le plus simple est de demander a Claude :
#     « Fabrique-moi le fichier .env de Squash avec trois secrets au hasard. »
#
# Contrainte du produit, a respecter : SQUASH_JWT doit faire AU MOINS 86 caracteres.
# (Squash exige une cle d'au moins 512 bits encodee en base64.)

POSTGRES_PASSWORD=remplace-moi
SQUASH_CRYPTO=remplace-moi
SQUASH_JWT=remplace-moi-par-au-moins-86-caracteres
